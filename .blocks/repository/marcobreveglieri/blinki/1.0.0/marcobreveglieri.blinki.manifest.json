{
  "$schema": "https://delphi-blocks.dev/schema/package.v1.json",
  "id": "marcobreveglieri.blinki",
  "name": "Blinki",
  "version": "1.0.0",
  "description": "A library for modern, beautiful Text User Interfaces (TUIs) for Delphi",
  "license": "MIT",
  "homepage": "https://github.com/marcobreveglieri/Blinki",
  "repository": {
    "type": "github",
    "url": "https://github.com/marcobreveglieri/Blinki/tree/v1.0.0"
  },
  "author": "Marco Breveglieri",
  "keywords": [
    "delphi",
    "tui",
    "terminal",
    "console",
    "text user interface",
    "text ui"
  ],
  "platforms": {
    "Win32,Win64,Win64x,Linux64": {
      "sourcePath": [
        "Source"
      ]
    }
  },
  "packages": [
    {
      "name": "Blinki",
      "type": [
        "runtime"
      ]
    }
  ],
  "packageOptions": {
    "folders": {
      "delphi11+": "..\\Source"
    }
  }
}
